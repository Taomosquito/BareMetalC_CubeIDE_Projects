#define MORSE_SELECTOR(arr) morse_selector(arr, sizeof(arr) / sizeof(arr[0]))
void morse_selector(int *arr, int size) {
	for (int i = 0; i < size; i++){
		HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 1);
		HAL_Delay(arr[i]);
		HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 0);
		HAL_Delay(100);
	}
	HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 0);
}
