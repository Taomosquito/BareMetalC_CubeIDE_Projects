int count;
int *pCount = &count;

bool prev_val = false;  // Declare the static variable as a pointer
bool *pPrevVal = &prev_val;

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
    if (GPIO_Pin == B1_Pin) {
        uint32_t current_time = HAL_GetTick();  // Get the current system time in milliseconds
        static uint32_t last_press_time = 0;  // Assign the type 'uint32_t' to the time variable


        // Check if enough time has passed since the last button press (debouncing)
        if (current_time - last_press_time > 1000) {  // 1s debounce time
            if (!(*pPrevVal)) {  // Dereference the pointer to check the value of prev_val
                // Increment count and handle reset if necessary
                if (*pCount >= 10) {
                    *pCount = 0;
                }
                *pPrevVal = true;  // Set prev_val to true via the pointer
                last_press_time = current_time;  // Update the last press time
            }
        }
    } else {
        *pPrevVal = false;  // Reset prev_val when the button is released
    }

	switch (*pCount) {
		case 0: {
			HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 0);
			__disable_irq();
			break;
		}
		case 1: {
			MORSE_SELECTOR(MORSE_H);
			__disable_irq();
			break;
		}
		case 2: {
			MORSE_SELECTOR(MORSE_E);
			__disable_irq();
			break;
		}
		case 3: {
			MORSE_SELECTOR(MORSE_L);
			__disable_irq();
			break;
		}
		case 4: {
			MORSE_SELECTOR(MORSE_L);
			__disable_irq();
			break;
		}
		case 5: {
			MORSE_SELECTOR(MORSE_O);
			__disable_irq();
			break;
		}
		case 6: {
			MORSE_SELECTOR(MORSE_W);
			__disable_irq();
			break;
		}
		case 7: {
			MORSE_SELECTOR(MORSE_O);
			__disable_irq();
			break;
		}
		case 8: {
			MORSE_SELECTOR(MORSE_R);
			__disable_irq();
			break;
		}
		case 9: {
			MORSE_SELECTOR(MORSE_L);
			break;
		}
		default:
			MORSE_SELECTOR(MORSE_D);
	}
}
